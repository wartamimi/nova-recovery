# NOVA Recovery - build configuration (tracked).
# Put machine-specific overrides in nova/config/build.local.env (untracked).

# ---- Target ---------------------------------------------------------------
NOVA_DEVICE="citrus"
NOVA_VENDOR="xiaomi"
NOVA_LUNCH_TARGET="twrp_citrus-eng"
NOVA_RELEASE_NAME="NOVA Recovery Beta"
NOVA_RELEASE_LABEL="EXPERIMENTAL"   # becomes "BETA" only after device testing (docs/TESTING.md, Stage 4-5)

# ---- Upstream (verified 2026-11-12, see docs/DEVICE_RESEARCH.md section 3) ----
NOVA_MANIFEST_URL="https://github.com/minimal-manifest-twrp/platform_manifest_twrp_aosp.git"
NOVA_MANIFEST_BRANCH="twrp-12.1"
NOVA_MANIFEST_REV="6dc117d9cbd08430daa16db2013560e1c4017fa8"
NOVA_TWRP_VERSION="3.7.1_12"

# ---- Paths ----------------------------------------------------------------
# The TWRP/AOSP source tree is large (~40-60 GB synced) and lives outside this repo.
NOVA_SRC_DIR="${NOVA_SRC_DIR:-$HOME/nova-twrp-src}"
NOVA_OUT_LOG_DIR="${NOVA_OUT_LOG_DIR:-${NOVA_ROOT:-.}/out/logs}"
NOVA_RELEASE_DIR="${NOVA_RELEASE_DIR:-${NOVA_ROOT:-.}/release}"

# ---- Build host minimums (checked by scripts/setup.sh) --------------------
NOVA_MIN_DISK_GB=120
NOVA_MIN_RAM_GB=16
NOVA_JOBS="${NOVA_JOBS:-$(nproc 2>/dev/null || echo 4)}"
